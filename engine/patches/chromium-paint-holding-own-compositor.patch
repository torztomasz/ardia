+void BrowserCompositorMac::ParkOwnCompositor() {
+  recyclable_compositor_->Suspend();
+  parked_compositor_ = std::move(recyclable_compositor_);
+  parked_compositor_timer_.Start(
+      FROM_HERE, kParkedCompositorLifetime,
+      base::BindOnce(&BrowserCompositorMac::ReleaseParkedCompositor,
+                     base::Unretained(this)));
+}
+
+void BrowserCompositorMac::ReleaseParkedCompositor() {
+  parked_compositor_timer_.Stop();
+  if (!parked_compositor_) {
+    return;
+  }
+  parked_compositor_->widget()->ResetNSView();
+  parked_compositor_->compositor()->SetRootLayer(nullptr);
+  parked_compositor_.reset();
+}
+
+void BrowserCompositorMac::RetireParkedCompositor() {
+  if (!parked_compositor_) {
+    return;
+  }
+  const base::TimeDelta left = std::max(
+      parked_compositor_timer_.desired_run_time() - base::TimeTicks::Now(),
+      base::TimeDelta());
+  parked_compositor_timer_.Stop();
+  parked_compositor_->widget()->ResetNSView();
+  parked_compositor_->compositor()->SetRootLayer(nullptr);
+  const uintptr_t retired =
+      reinterpret_cast<uintptr_t>(parked_compositor_.get());
+  GetRetiredCompositors().push_back(std::move(parked_compositor_));
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&ForgetRetiredCompositor, retired), left);
+}
